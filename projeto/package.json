    "@react-three/postprocessing": "2.19.1",
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/three": "4.0.540",
    "postprocessing": "6.37.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.171.0",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
